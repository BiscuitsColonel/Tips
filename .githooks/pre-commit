#!/bin/sh
# public リポジトリなので、漏えい検査に通らないコミットを止める。
# ステージ済みの内容（このコミットに入るもの）を検査する。
# 有効にする: git config core.hooksPath .githooks （clone ごとに1回）
cd "$(git rev-parse --show-toplevel)" || exit 1

PY=
for c in python3 python "py -3"; do
  if $c -c "import sys; sys.exit(sys.version_info < (3, 8))" >/dev/null 2>&1; then PY=$c; break; fi
done
if [ -z "$PY" ]; then
  echo "Python 3 が見つからないので、検査できずコミットを止めました。"
  exit 1
fi

if ! out=$(PYTHONIOENCODING=utf-8 $PY scripts/check-tips.py --staged 2>&1); then
  printf '%s\n' "$out"
  echo "check-tips.py で問題が見つかったので、コミットを止めました。"
  exit 1
fi
